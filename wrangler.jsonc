/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vbc-order-of-service",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "account_id": "23f99d3ef188b488e18827b853b73295",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vbc-order-of-service",
      "migrations_dir": "./migrations",
      "database_id": "ac1c9ff0-03f2-4328-9b9a-266fa5c09af5",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SERVICE_PDFS",
      "bucket_name": "vbc-order-of-service-pdfs",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  // Non-secret gateway routing for env.AI.run (same pattern as product-gen-portal).
  "vars": {
    "AI_GATEWAY_ID": "default",
  },
  "queues": {
    "producers": [
      {
        "binding": "OOS_EMAIL_SENDER",
        "queue": "oos-email-sender",
      },
      {
        "binding": "OOS_ANNOUNCEMENT_IMAGE_GEN",
        "queue": "oos-announcement-image-gen",
      },
    ],
    "consumers": [
      {
        "queue": "oos-email-sender",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 0,
      },
      {
        "queue": "oos-announcement-image-gen",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        // One consumer only — AI image payloads + SSR share the 128MB isolate.
        "max_concurrency": 1,
        "dead_letter_queue": "oos-announcement-image-gen-dlq",
        "retry_delay": 30,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_EMAIL_STATUS",
        "class_name": "OrderEmailStatusDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-order-email-status",
      "new_sqlite_classes": ["OrderEmailStatusDurableObject"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": {  "directory": "./public/",  "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
