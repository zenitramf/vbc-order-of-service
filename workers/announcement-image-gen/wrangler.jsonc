/**
 * Slim Worker hosting the Rick chat agent Durable Object. (The announcement
 * image-gen consumer that used to share this Worker was removed; the name is
 * kept so the cross-script Durable Object binding does not move.)
 * Deploy with: pnpm deploy:image-gen
 * Must be deployed for the portal's Rick assistant to be reachable.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vbc-oos-announcement-image-gen",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "account_id": "23f99d3ef188b488e18827b853b73295",
  "durable_objects": {
    "bindings": [
      {
        "name": "RICK_AGENT",
        "class_name": "RickAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-rick-agent",
      "new_sqlite_classes": ["RickAgent"],
    },
  ],
  "services": [
    {
      "binding": "PORTAL",
      "service": "vbc-order-of-service",
    },
  ],
  // No public HTTP surface: the portal reaches Rick through the cross-script
  // Durable Object binding. Keep this off and add no routes.
  "workers_dev": false,
  "vars": {
    "RICK_MODEL": "openai/gpt-6-luna",
    "RICK_REASONING_EFFORT": "medium",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
