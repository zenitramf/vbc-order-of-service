/**
 * Slim Worker: announcement AI image generation queue consumer only.
 * Deploy with: pnpm deploy:image-gen
 * Must be deployed for Generate Background to complete (writes JPEGs to R2).
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vbc-oos-announcement-image-gen",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "account_id": "23f99d3ef188b488e18827b853b73295",
  "r2_buckets": [
    {
      "binding": "SERVICE_PDFS",
      "bucket_name": "vbc-order-of-service-pdfs",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "AI_GATEWAY_ID": "default",
  },
  "queues": {
    "consumers": [
      {
        "queue": "oos-announcement-image-gen",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "oos-announcement-image-gen-dlq",
        "retry_delay": 30,
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
