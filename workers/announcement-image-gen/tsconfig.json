{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts",
    "../../src/lib/rick-agent-token.ts",
    "../../src/lib/rick-approval.ts"
  ]
}
